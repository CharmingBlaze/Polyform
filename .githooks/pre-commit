#!/bin/sh
# Pre-commit gate: typecheck, unit tests, e2e (glb export validated by the Khronos validator), build.
# Installed by `npm install` / `npm run prepare` (git config core.hooksPath .githooks). Do not bypass with --no-verify.
set -e
cd "$(git rev-parse --show-toplevel)"
echo "[pre-commit] typecheck"; npm run --silent typecheck
echo "[pre-commit] test";      npm run --silent test
echo "[pre-commit] test:e2e";  npm run --silent test:e2e
echo "[pre-commit] build";     npm run --silent build
echo "[pre-commit] all green"
