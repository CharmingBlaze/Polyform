{
  "name": "lowpoly",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/prepare.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:errors": "eslint . --quiet",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "node tests/e2e/run.mjs export.mjs viewport.mjs gizmo.mjs tweak.mjs extrude.mjs loopcut.mjs knife.mjs drawprim.mjs rig.mjs joints.mjs timeline.mjs uv.mjs paint.mjs vcolor.mjs workspace.mjs outliner.mjs",
    "test:workflow": "node tests/e2e/run.mjs workflow.mjs",
    "test:viewport": "node tests/e2e/run.mjs viewport.mjs",
    "typecheck": "tsc -b",
    "test:gizmo": "node tests/e2e/run.mjs gizmo.mjs",
    "test:tweak": "node tests/e2e/run.mjs tweak.mjs",
    "test:extrude": "node tests/e2e/run.mjs extrude.mjs",
    "test:loopcut": "node tests/e2e/run.mjs loopcut.mjs",
    "test:knife": "node tests/e2e/run.mjs knife.mjs",
    "test:drawprim": "node tests/e2e/run.mjs drawprim.mjs",
    "test:rig": "node tests/e2e/run.mjs rig.mjs",
    "test:joints": "node tests/e2e/run.mjs joints.mjs",
    "test:timeline": "node tests/e2e/run.mjs timeline.mjs",
    "test:uv": "node tests/e2e/run.mjs uv.mjs"
  },
  "dependencies": {
    "comlink": "4.4.2",
    "idb-keyval": "6.3.0",
    "lucide-react": "1.59.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1",
    "xatlasjs": "0.2.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "gltf-validator": "2.0.0-dev.3.10",
    "playwright-core": "1.64.1",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.11.0",
    "vite": "8.3.4",
    "vitest": "4.1.12"
  }
}
